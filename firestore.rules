rules_version = '2';

// Reglas de seguridad de Firestore para el Sistema de Control Ganadero.
// Pégalas en Firebase › Firestore Database › Reglas, y pulsa "Publicar".
//
// Modelo: un documento por rancho en la colección "ranchos". El documento guarda
// el padrón completo (payloadJson) y una lista "miembros" con los UID de las cuentas
// de Firebase Authentication que pueden verlo y modificarlo.
service cloud.firestore {
  match /databases/{database}/documents {

    match /ranchos/{ranchoId} {
      function esMiembro() {
        return request.auth != null && request.auth.uid in resource.data.miembros;
      }

      // Leer: solo miembros del rancho.
      allow get: if esMiembro();

      // Crear: cualquier cuenta autenticada puede crear un rancho NUEVO,
      // pero solo con ella misma como único miembro.
      allow create: if request.auth != null
        && request.resource.data.miembros == [request.auth.uid]
        && request.resource.data.payloadJson is string
        && request.resource.data.payloadJson.size() < 1000000;

      // Actualizar: solo miembros, sin poder cambiar la lista de miembros desde la app
      // (los miembros se administran desde la consola de Firebase).
      allow update: if esMiembro()
        && request.resource.data.miembros == resource.data.miembros
        && request.resource.data.payloadJson is string
        && request.resource.data.payloadJson.size() < 1000000;

      // Nadie puede listar todos los ranchos ni borrarlos desde la app.
      allow list, delete: if false;
    }

    // Cualquier otra ruta está cerrada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
